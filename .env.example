# Frontend
VITE_API_BASE_URL=http://localhost:3001

# Supabase (server-side only — NEVER expose the service role key to the browser)
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend (email + checkout API)
PORT=3001
CLIENT_URL=http://localhost:3000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=info@voltcraft.org.ng

# Optional: prefer Brevo API delivery (more reliable than SMTP on some cloud hosts)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional shipping rates override as JSON array
# SHIPPING_RATES_JSON=[{"id":"lagos-mainland","label":"Lagos Mainland","fee":3000,"eta":"1-2 business days"}]

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/quote?payment=paystack

# Solana Pay
SOLANA_RECIPIENT_ADDRESS=YourSolanaWalletAddress
SOLANA_NGN_PER_SOL=114400
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
